{
  "name": "dsh-cc-relay",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Automatically translate model response wrappers and Claude Code/Codex JSON into DSH stream blocks.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./normalize": "./lib/normalize.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib/normalize.js", "lib/structured.js", "lib/tagged-text.js", "lib/tools.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "engines": { "node": ">=22.19" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test test/normalize.test.mjs",
    "test:runtime": "node --import ./test/runtime-register.mjs --test test/runtime.test.mjs",
    "check": "node --check index.js && node --check lib/normalize.js && node --check lib/structured.js && node --check lib/tagged-text.js && node --check lib/tools.js"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
